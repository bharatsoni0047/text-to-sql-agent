# copy this file to .env and fill in your own values - never commit the real .env

# the model that writes the answers. any OpenAI-compatible endpoint works.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.5-flash

# login. leave all three EMPTY to turn login off completely (local testing only).
# JWT_SECRET should be a long random string - generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
APP_USERNAME=
APP_PASSWORD=

# database details are NOT stored here - they are sent to /connect at runtime
